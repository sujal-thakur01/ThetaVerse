{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoadmapGenerationResponse",
  "type": "object",
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "estimatedHours", "referenceLinks", "subtopics"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "estimatedHours": {
            "type": "number",
            "minimum": 0
          },
          "priority": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "referenceLinks": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "subtopics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
